BlackHolePreviewItem: {
	DisplayName: 黑洞背景测试器
	Tooltip: 使用切换本地微光星空与黑洞背景；再次使用关闭，退出世界自动关闭
}

MikaDomainScatterSword: {
	DisplayName: 未花星光扩散测试剑
	Tooltip: 黑洞领域开启时使用，2秒17帧后让已激活的星光飞出屏幕（按每秒30帧计）
}

MikaDomainTuningFlower: {
	DisplayName: 未花黑洞调色花
	Tooltip: 调整遮罩透明度、光谱饱和度与前后星光发光
}

MikaDomainTuningApple: {
	DisplayName: 未花黑洞视野苹果
	Tooltip: 调整固定显示范围、宽高比锁定与共鸣抖动
}

MikaDomainCrystal: {
	DisplayName: 未花共鸣调试水晶
	Tooltip: 黑洞领域内以一档能量立即释放共鸣，保留储能，冷却10秒
}

MikaShatterPeach: {
	DisplayName: 未花碎片调试桃
	Tooltip: 实时调整玻璃碎片的厚度、作用力、运动和反光
}

MikaOpeningGrenade: {
	DisplayName: 未花裂纹调试手雷
	Tooltip: 在没有黑洞领域时使用，直接测试裂纹、碎片与领域音乐
}

TestItem: {
	DisplayName: 调试物品
	Tooltip:
		'''
		一个调试道具，可能会因为版本随时发生变化
		不过你是怎么看到这个东西的？
		'''
}

