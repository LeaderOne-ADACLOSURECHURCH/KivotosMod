	DisplayName: 武器等级重置器（开发者）
	Tooltip:
		'''
		先选中快捷栏中的学员武器，再右键背包里的本物品，将该武器重置为Lv.1。
		只重置这一把，不返还升级材料或货币；道具不会消耗。
		'''
}

WeaponLevelBooster: {
	DisplayName: 武器快速升级器（开发者）
	Tooltip:
		'''
		先选中快捷栏中的学员武器，再右键背包里的本物品，每次提升1级，最高Lv.10。
		仅供开发测试：不检查Boss进度，不消耗升级材料、货币或本道具。
		'''
}

