WeaponLevelResetter: {
	DisplayName: Weapon Level Resetter (Developer)
	Tooltip:
		'''
		Select a student weapon in the hotbar, then right-click this tool in your inventory to reset that weapon to Lv.1.
		No materials or currency are refunded. The tool is not consumed.
		'''
}

WeaponLevelBooster: {
	DisplayName: Weapon Level Booster (Developer)
	Tooltip:
		'''
		Select a student weapon in the hotbar, then right-click this tool in your inventory to add one level, up to Lv.10.
		For development testing: ignores boss progress and consumes no materials, currency, or tool.
		'''
}

StepByStepMusicBox: {
	Tooltip:
		'''
		播放基沃托斯主界面音乐
		可装备，或放置后右键及电线开关
		'''
	DisplayName: 音乐盒（Step by Step）
}

