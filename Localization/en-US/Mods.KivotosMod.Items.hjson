BlackHolePreviewItem: {
	DisplayName: Black Hole Background Tester
	Tooltip: Use to toggle the local shimmer starfield and black hole; resets on leaving the world
}

MikaDomainScatterSword: {
	DisplayName: Mika Starlight Scatter Test Sword
	Tooltip: Use in the domain to scatter active stars after 2 seconds and 17 frames at 30 FPS.
}

MikaDomainTuningFlower: {
	DisplayName: Mika Domain Tuning Flower
	Tooltip: Adjust matte opacity, spectrum saturation, and foreground and background bloom.
}

MikaDomainTuningApple: {
	DisplayName: Mika Domain Viewport Apple
	Tooltip: Adjust the fixed viewport, aspect ratio lock, and resonance shake.
}

MikaDomainCrystal: {
	DisplayName: Mika Resonance Test Crystal
	Tooltip: Cast one-stack Resonance in your domain without spending stored energy. 10 second cooldown.
}

MikaShatterPeach: {
	DisplayName: Mika Shatter Tuning Peach
	Tooltip: Adjust the thickness, force, motion and reflections of the glass shards.
}

MikaOpeningGrenade: {
	DisplayName: Mika Opening Test Grenade
	Tooltip: Begin the crack and shatter sequence and open the domain with its music.
}

TestItem: {
	DisplayName: Test Item
